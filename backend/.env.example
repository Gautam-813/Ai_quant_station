# Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# REQUIRED - JWT Settings (MUST change SECRET_KEY in production!)
# =============================================================================
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Database
# =============================================================================
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finance_engine
# For development (SQLite, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./finance_engine.db

# =============================================================================
# Default Admin Password (MUST change in production!)
# =============================================================================
DEFAULT_ADMIN_PASSWORD=admin2026

# =============================================================================
# MT5 Settings (optional - for live trading)
# =============================================================================
MT5_SERVER_PORT=5000
MT5_API_TOKEN=change-this-to-a-random-token
MT5_CONNECTOR_URL=http://localhost:5001
MT5_USE_EXTERNAL_CONNECTOR=False
MT5_BROKER_UTC_OFFSET=0

# =============================================================================
# HuggingFace Settings (optional - for data archiving)
# =============================================================================
HUGGINGFACE_API_KEY=
HF_REPO_ID=TheFinanceEngineer/impulse-market-data

# =============================================================================
# AI Providers (optional - can be configured in app settings)
NVIDIA_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_API_KEY=
GEMINI_API_KEY=
GITHUB_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000